# Bu faylni nusxalab ".env" deb nomlang va qiymatlarni to'ldiring.

# @BotFather dan olingan token
BOT_TOKEN=BU_YERGA_TOKENNI_QOYING

# Admin Telegram ID lari (vergul bilan). Bo'sh qoldirsangiz,
# botga birinchi /start yozgan odam bosh admin bo'ladi.
ADMIN_IDS=

# Boshlang'ich haftalik to'lov (keyin botning Sozlamalar bo'limidan o'zgartiriladi)
WEEKLY_FEE=90000

# Yakshanba kuni soat nechadan keyin avtomatik hisobot yuborilsin
WEEKLY_REPORT_HOUR=20

# ---- Telegram Mini App (ilova) ----
# Ilovaning internetdagi HTTPS manzili. Bo'sh bo'lsa, botda «Ochish» tugmasi chiqmaydi.
WEBAPP_URL=
# Ilova serveri qaysi portda ishlaydi (Caddy/tunnel shu portga ulanadi)
WEBAPP_PORT=8080
WEBAPP_HOST=127.0.0.1
